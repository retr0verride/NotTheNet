# NotTheNet environment template.
# Copy to .env (which is gitignored) and fill in. Never commit .env.

# ── Health / metrics API ─────────────────────────────────────────────────────
# Required to expose /health/status and /metrics on a non-loopback bind
# (the docker-compose default is NTN_HEALTH_BIND=0.0.0.0). Without a token set,
# those two endpoints return 403 off-loopback. Generate a strong value, e.g.:
# Minimum 16 characters; startup fails on anything shorter. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
NTN_ADMIN_TOKEN=

# A Prometheus scrape job sends it as a bearer credential:
#   authorization:
#     credentials: <same value as NTN_ADMIN_TOKEN>

# ── Optional overrides ───────────────────────────────────────────────────────
# NTN_LOG_LEVEL=INFO
# NTN_HEALTH_ENABLED=1          # the Docker image already sets this
# NTN_HEALTH_BIND=127.0.0.1
# NTN_HEALTH_PORT=8080
# NTN_HEALTH_CORS_ORIGINS=      # comma-separated allowlist; empty = no CORS
